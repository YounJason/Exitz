---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

interface Props {
  post: CollectionEntry<"help">;
}

export async function getStaticPaths() {
  const helpPosts = await getCollection("help");
  return helpPosts.map((post: CollectionEntry<"help">) => ({
    params: { slug: post.slug ?? post.id },
    props: { post },
  }));
}

const post = (Astro.props as Props).post;
const data = post.data;
const currentUrl = Astro.url.toString();
const { Content } = await post.render();
---

<Layout
  title={data.title}
  description={data.description}
  url={currentUrl}
  type="article"
>
  <div class="container article-container">
    <nav class="breadcrumb">
      <a href="/">Exitz</a> &gt; <a href="/help">개인정보 도움말</a>
    </nav>

    <article class="article-content">
      <h1>{post.data.title}</h1>

      <div class="article-meta">
        {
          post.data.description && (
            <p class="description">{post.data.description}</p>
          )
        }
        <span
          >최근 업데이트: {post.data.pubDate.toISOString().slice(0, 10)}</span
        >
        <span class="view-count-badge">
          <span aria-hidden="true">👁</span>
          <span id="view-count">-</span>
        </span>
      </div>

      <hr class="divider" />

      <div class="markdown-body">
        <Content />
      </div>
    </article>
  </div>
</Layout>

<script
  is:inline
  define:vars={{
    postSlug: post.slug ?? post.id,
    postType: "help",
  }}
>
  (async () => {
    const viewEl =
      document.getElementById("view-count");

    if (!viewEl || !postSlug) return;

    try {
      const key =
        `exitz_viewed_${postType}_${postSlug}`;

      const oneDay = 24 * 60 * 60 * 1000;
      const lastViewed =
        localStorage.getItem(key);

      const now = Date.now();

      const shouldCount =
        !lastViewed ||
        now - Number(lastViewed) > oneDay;

      const response = await fetch(
        `/api/views/${encodeURIComponent(postSlug)}?type=${postType}`,
        {
          method: shouldCount ? "POST" : "GET",
        },
      );

      if (shouldCount) {
        localStorage.setItem(
          key,
          String(now),
        );
      }

      if (response.ok) {
        const data = await response.json();

        viewEl.textContent =
          Number(data.views).toLocaleString("ko-KR");
      } else {
        viewEl.textContent = "0";
      }
    } catch (error) {
      console.error(
        "조회수 로드 실패:",
        error,
      );

      viewEl.textContent = "0";
    }
  })();
</script>

<style>
  .article-container {
    width: min(720px, calc(100% - 40px));
    margin: 0 auto;
    padding-top: 48px;
    padding-bottom: 80px;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 24px;
    font-weight: 500;
  }

  .breadcrumb a {
    color: var(--ink);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .article-content h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 12px;
  }

  .article-meta {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 8px;
  }

  .description {
    font-size: 1.05rem;
    color: var(--muted);
    margin-bottom: 8px;
    line-height: 1.5;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--line);
    margin: 32px 0;
  }

  .markdown-body :global(h2) {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 40px;
    margin-bottom: 16px;
    color: var(--ink);
  }

  .markdown-body :global(p) {
    margin-bottom: 20px;
    color: var(--ink);
    line-height: 1.7;
    font-size: 1rem;
  }

  .markdown-body :global(ol),
  .markdown-body :global(ul) {
    margin-bottom: 24px;
    padding-left: 24px;
    color: var(--ink);
  }

  .markdown-body :global(li) {
    margin-bottom: 8px;
    color: var(--ink);
    line-height: 1.6;
  }

  .markdown-body :global(blockquote) {
    background: #f2f4f6;
    border-left: 4px solid var(--ink);
    padding: 16px 20px;
    border-radius: 0 12px 12px 0;
    margin: 24px 0;
    color: #333d4b;
    font-size: 0.95rem;
  }

  .markdown-body :global(code) {
    background: #f2f4f6;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.95rem;
  }

  .markdown-body :global(img) {
    max-width: 100%;
    border-radius: 12px;
    margin: 24px 0;
  }
</style>
