---
// @ts-ignore
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const exitPosts = await getCollection('blog');
const privacyPosts = await getCollection('privacy');
const domainMap = JSON.stringify(exitPosts.map((post: any) => ({domain: post.data.domain.toLowerCase(), slug: post.slug})));
const privacySearchData = JSON.stringify(privacyPosts.map((post: any) => ({title: post.data.title.toLowerCase(), slug: post.slug})));
---
<Layout title="Exitz">
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">ACCOUNT EXIT GUIDE</p>
      <h1>떠나는 것도,<br /><em>깔끔하게.</em></h1>
      <p class="intro">서비스 이름이나 도메인을 검색하면<br />회원 탈퇴 방법을 바로 찾아드려요.</p>
      <form id="search-form" class="search-box">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input id="search-input" type="text" placeholder="instagram.com" required autocomplete="off" aria-label="서비스 검색" />
        <button type="submit">찾기</button>
      </form>
      <p id="error-message" class="error" hidden>해당 서비스를 아직 찾지 못했어요.</p>
      <div class="examples"><span>예시</span><button type="button" data-example="facebook.com">facebook.com</button><button type="button" data-example="instagram.com">instagram.com</button></div>
    </div>
  </section>

  <section class="content">
    <div class="section-head"><div><p class="eyebrow">EXPLORE</p><h2>필요한 정보를 골라보세요.</h2></div><span class="count">{exitPosts.length + privacyPosts.length} guides</span></div>
    <div class="main-grid">
      <section class="guide-section">
        <div class="section-label"><span class="label-number">01</span><div><h3>계정 탈퇴</h3><p>서비스별 탈퇴 방법을 한눈에</p></div></div>
        <div class="card-list">
          {exitPosts.map((post: any) => <a href={`/x/${post.slug}`} class="guide-card"><span class="card-arrow">↗</span><div><h4>{post.data.title}</h4><span class="domain">{post.data.domain}</span></div></a>)}
        </div>
      </section>
      <section class="guide-section">
        <div class="section-label"><span class="label-number">02</span><div><h3>개인정보 도움말</h3><p>탈퇴 전 알아두면 좋은 것들</p></div></div>
        <div class="card-list">
          {privacyPosts.map((post: any) => <a href={`/h/${post.slug}`} class="guide-card"><span class="card-arrow">↗</span><div><h4>{post.data.title}</h4><p>{post.data.description}</p></div></a>)}
        </div>
      </section>
    </div>
  </section>
</Layout>
<script is:inline define:vars={{ domainMapJson: domainMap, privacySearchJson: privacySearchData }}>
  const domainData=JSON.parse(domainMapJson); const privacyData=JSON.parse(privacySearchJson); const form=document.getElementById('search-form'); const input=document.getElementById('search-input'); const errorMsg=document.getElementById('error-message');
  form?.addEventListener('submit',(e)=>{e.preventDefault(); errorMsg.hidden=true; const query=input.value.trim().toLowerCase(); const domain=query.replace(/^https?:\/\//,'').replace(/^www\./,'').split('/')[0]; const exit=domainData.find((x)=>x.domain===domain); if(exit){location.href=`/x/${exit.slug}`;return} const help=privacyData.find((x)=>x.title.includes(query)); if(help){location.href=`/h/${help.slug}`;return} errorMsg.hidden=false;});
  document.querySelectorAll('[data-example]').forEach((button)=>button.addEventListener('click',()=>{input.value=button.dataset.example; input.focus();}));
</script>
<style>
.hero{border-bottom:1px solid var(--line);background:radial-gradient(circle at 50% 15%,#fff 0,transparent 45%);padding:92px 20px 84px}.hero-inner{width:min(720px,100%);margin:auto;text-align:center}.eyebrow{font-size:.7rem;font-weight:700;letter-spacing:.14em;color:var(--muted);margin-bottom:16px}.hero h1{font-size:clamp(3rem,8vw,5.8rem);line-height:.98;letter-spacing:-.075em;font-weight:700}.hero h1 em{font-style:normal;color:#77746d}.intro{font-size:1rem;color:var(--muted);margin:26px 0 34px}.search-box{height:64px;display:flex;align-items:center;background:var(--surface);border:1px solid #d9d7d0;border-radius:16px;padding:7px 7px 7px 20px;box-shadow:0 12px 36px rgba(23,23,23,.07);text-align:left;transition:.2s}.search-box:focus-within{border-color:#99958c;box-shadow:0 14px 42px rgba(23,23,23,.11)}.search-icon{font-size:1.6rem;color:var(--muted);line-height:1;margin-right:10px}.search-box input{min-width:0;flex:1;border:0;outline:0;background:transparent;font-size:1rem;color:var(--ink)}.search-box button{border:0;background:var(--ink);color:#fff;height:50px;padding:0 23px;border-radius:11px;font-weight:600;cursor:pointer}.search-box button:hover{background:#333}.error{margin-top:12px;color:var(--danger);font-size:.86rem}.examples{display:flex;justify-content:center;align-items:center;gap:8px;margin-top:16px;font-size:.75rem;color:var(--muted)}.examples button{border:0;background:transparent;color:var(--muted);text-decoration:underline;text-underline-offset:3px;cursor:pointer}.content{width:min(1080px,calc(100% - 40px));margin:0 auto;padding:72px 0}.section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:38px}.section-head .eyebrow{margin-bottom:5px}.section-head h2{font-size:1.7rem;letter-spacing:-.045em}.count{font-size:.75rem;color:var(--muted)}.main-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px}.section-label{display:flex;gap:15px;align-items:flex-start;padding-bottom:18px;border-bottom:1px solid var(--line);margin-bottom:12px}.label-number{font-size:.7rem;color:var(--muted);padding-top:4px}.section-label h3{font-size:1.1rem;letter-spacing:-.025em}.section-label p{font-size:.78rem;color:var(--muted);margin-top:2px}.card-list{display:flex;flex-direction:column}.guide-card{position:relative;display:block;text-decoration:none;padding:18px 34px 18px 2px;border-bottom:1px solid var(--line);transition:padding .2s,background .2s}.guide-card:hover{padding-left:9px;background:rgba(255,255,255,.55)}.guide-card h4{font-size:.96rem;font-weight:600;letter-spacing:-.02em}.domain{display:inline-block;margin-top:4px;color:var(--muted);font-size:.72rem}.guide-card p{font-size:.8rem;color:var(--muted);margin-top:4px;line-height:1.5}.card-arrow{position:absolute;right:3px;top:20px;color:#aaa;font-size:1.1rem;transition:.2s}.guide-card:hover .card-arrow{right:8px;color:var(--ink)}@media(max-width:760px){.hero{padding:68px 14px 60px}.hero h1{font-size:3.5rem}.content{width:min(100% - 28px,1080px);padding:52px 0}.section-head{align-items:start}.main-grid{grid-template-columns:1fr;gap:48px}.search-box{height:58px}.search-box button{height:44px;padding:0 18px}}
</style>
