---
// @ts-ignore
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const allExitPosts = await getCollection('blog');
const allPrivacyPosts = await getCollection('privacy');
const exitPosts = allExitPosts.slice(0, 20);
const privacyPosts = allPrivacyPosts.slice(0, 10);
const rowOne = exitPosts.filter((_: any, i: number) => i % 2 === 0);
const rowTwo = exitPosts.filter((_: any, i: number) => i % 2 !== 0);
const domainMap = JSON.stringify(allExitPosts.map((post: any) => ({domain: post.data.domain.toLowerCase(), slug: post.slug})));
const privacySearchData = JSON.stringify(allPrivacyPosts.map((post: any) => ({title: post.data.title.toLowerCase(), slug: post.slug})));
---
<Layout title="Exitz">
<section class="hero"><div class="hero-inner"><p class="eyebrow">ACCOUNT EXIT GUIDE</p><h1>떠나는 것도,<br /><em>깔끔하게.</em></h1><p class="intro">서비스 이름이나 도메인을 검색하면<br />회원 탈퇴 방법을 바로 찾아드려요.</p><form id="search-form" class="search-box"><span class="search-icon" aria-hidden="true">⌕</span><input id="search-input" type="text" placeholder="" required autocomplete="off" aria-label="서비스 검색" /><button type="submit">찾기</button></form><p id="error-message" class="error" hidden>해당 서비스를 아직 찾지 못했어요.</p></div></section>
<section class="explore"><div class="explore-intro"><div><p class="eyebrow">EXPLORE</p><h2>필요한 정보를<br />천천히 골라보세요.</h2></div><p class="explore-copy">계정 탈퇴 가이드와<br />개인정보에 관한 짧은 도움말을 모았어요.</p></div>
<section class="exit-section"><div class="section-top"><div class="section-title"><span>01</span><div><h3>계정 탈퇴 가이드</h3><p>자주 찾는 서비스부터 빠르게</p></div></div><a class="view-all" href="/guides">전체보기 <span>↗</span></a></div><div class="conveyor" aria-label="계정 탈퇴 가이드"><div class="lane lane-one"><div class="lane-track">{[...rowOne,...rowOne].map((post:any)=><a class="service-card" href={`/x/${post.slug}`}>{post.data.logo?<img class="service-logo" src={post.data.logo} alt={`${post.data.serviceName} 로고`} loading="lazy"/>:<span class="logo-fallback">{post.data.serviceName?.charAt(0)}</span>}<div class="service-info"><strong>{post.data.serviceName}</strong><small>{post.data.domain}</small></div><span class="service-arrow">↗</span></a>)}</div></div><div class="lane lane-two"><div class="lane-track">{[...rowTwo,...rowTwo].reverse().map((post:any)=><a class="service-card" href={`/x/${post.slug}`}>{post.data.logo?<img class="service-logo" src={post.data.logo} alt={`${post.data.serviceName} 로고`} loading="lazy"/>:<span class="logo-fallback">{post.data.serviceName?.charAt(0)}</span>}<div class="service-info"><strong>{post.data.serviceName}</strong><small>{post.data.domain}</small></div><span class="service-arrow">↗</span></a>)}</div></div></div></section>
<section class="tips-section"><div class="section-top"><div class="section-title"><span>02</span><div><h3>개인정보 도움말</h3><p>탈퇴 전에 알아두면 좋은 내용</p></div></div><a class="view-all" href="/tips">전체보기 <span>↗</span></a></div><div class="tips-grid">{privacyPosts.map((post:any,index:number)=><a class="tip-card" href={`/h/${post.slug}`}><span class="tip-index">{String(index+1).padStart(2,'0')}</span><div><h4>{post.data.title}</h4><p>{post.data.description}</p></div><span class="tip-arrow">↗</span></a>)}</div></section></section>
</Layout>
<script is:inline define:vars={{domainMapJson:domainMap,privacySearchJson:privacySearchData}}>
const domainData=JSON.parse(domainMapJson);const privacyData=JSON.parse(privacySearchJson);const form=document.getElementById('search-form');const input=document.getElementById('search-input');const errorMsg=document.getElementById('error-message');form?.addEventListener('submit',(e)=>{e.preventDefault();errorMsg.hidden=true;const query=input.value.trim().toLowerCase();const domain=query.replace(/^https?:\/\//,'').replace(/^www\./,'').split('/')[0];const exit=domainData.find((x)=>x.domain===domain);if(exit){location.href=`/x/${exit.slug}`;return}const help=privacyData.find((x)=>x.title.includes(query));if(help){location.href=`/h/${help.slug}`;return}errorMsg.hidden=false});
const placeholderTexts=['facebook.com','instagram.com','twitter.com','youtube.com'];let currentIndex=0;function typePlaceholder(){const text=placeholderTexts[currentIndex];let charIndex=0;input.placeholder='';const typingInterval=setInterval(()=>{if(charIndex<text.length){input.placeholder+=text.charAt(charIndex);charIndex++}else{clearInterval(typingInterval);setTimeout(erasePlaceholder,1500)}},100)}function erasePlaceholder(){const erasingInterval=setInterval(()=>{if(input.placeholder.length>0)input.placeholder=input.placeholder.slice(0,-1);else{clearInterval(erasingInterval);currentIndex=(currentIndex+1)%placeholderTexts.length;typePlaceholder()}},30)}typePlaceholder();
</script>
<style>
.explore{width:min(1120px,calc(100% - 48px));margin:0 auto;padding:104px 0 120px}.explore-intro{display:flex;justify-content:space-between;align-items:end;padding-bottom:58px}.explore-intro .eyebrow{margin-bottom:12px}.explore-intro h2{font-size:clamp(2.3rem,5vw,4rem);line-height:1.04;letter-spacing:-.065em}.explore-copy{max-width:260px;color:var(--muted);font-size:.88rem;line-height:1.8;text-align:right}.exit-section,.tips-section{border-top:1px solid var(--line);padding-top:25px}.section-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:26px}.section-title{display:flex;gap:18px;align-items:flex-start}.section-title>span{font-size:.68rem;color:var(--muted);padding-top:4px}.section-title h3{font-size:1.05rem;letter-spacing:-.025em}.section-title p{font-size:.76rem;color:var(--muted);margin-top:3px}.view-all{font-size:.76rem;text-decoration:none;color:var(--muted);border-bottom:1px solid #cfcac0;padding-bottom:4px}.view-all span{margin-left:5px}.view-all:hover{color:var(--ink);border-color:var(--ink)}.conveyor{margin:0 calc((1120px - 100vw)/2);overflow:hidden;padding:7px 0 16px;display:flex;flex-direction:column;gap:12px}.lane{overflow:hidden;width:100%}.lane-track{display:flex;width:max-content;gap:12px;will-change:transform}.lane-one .lane-track{animation:move-left 38s linear infinite}.lane-two .lane-track{animation:move-right 42s linear infinite}.conveyor:hover .lane-track{animation-play-state:paused}.service-card{position:relative;display:flex;align-items:center;gap:13px;width:280px;height:116px;flex:0 0 280px;padding:18px 40px 18px 18px;background:var(--surface);border:1px solid var(--line);border-radius:17px;text-decoration:none;box-shadow:0 5px 18px rgba(23,23,23,.035);transition:transform .2s,border-color .2s,box-shadow .2s}.service-card:hover{transform:translateY(-3px);border-color:#bdb8ae;box-shadow:0 10px 28px rgba(23,23,23,.08)}.service-logo,.logo-fallback{width:54px;height:54px;flex:0 0 54px;object-fit:contain;border-radius:14px;background:#fff;border:1px solid var(--line);padding:8px}.logo-fallback{display:grid;place-items:center;background:var(--soft);padding:0;font-weight:700;font-size:1.1rem}.service-info{min-width:0;display:flex;flex-direction:column}.service-info strong{font-size:.92rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.service-info small{font-size:.7rem;color:var(--muted);margin-top:3px}.service-arrow{position:absolute;right:16px;top:15px;font-size:.9rem;color:#aaa}.service-card:hover .service-arrow{color:var(--ink)}@keyframes move-left{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 6px))}}@keyframes move-right{from{transform:translateX(calc(-50% - 6px))}to{transform:translateX(0)}}.tips-section{margin-top:84px}.tips-grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}.tip-card{position:relative;display:grid;grid-template-columns:38px 1fr;gap:13px;min-height:116px;padding:22px 40px 22px 0;border-bottom:1px solid var(--line);text-decoration:none;transition:padding .2s,background .2s}.tip-card:nth-child(odd){padding-left:0;padding-right:32px}.tip-card:nth-child(even){padding-left:24px;border-left:1px solid var(--line)}.tip-card:hover{background:var(--surface);padding-left:9px}.tip-card:nth-child(even):hover{padding-left:33px}.tip-index{font-size:.67rem;color:#aaa;padding-top:3px}.tip-card h4{font-size:.9rem;letter-spacing:-.02em}.tip-card p{font-size:.76rem;color:var(--muted);margin-top:5px;line-height:1.55;max-width:400px}.tip-arrow{position:absolute;right:12px;top:23px;color:#aaa;transition:.2s}.tip-card:hover .tip-arrow{right:18px;color:var(--ink)}@media(max-width:700px){.explore{width:calc(100% - 28px);padding:72px 0 88px}.explore-intro{display:block;padding-bottom:42px}.explore-copy{text-align:left;margin-top:22px}.conveyor{margin:0 -14px}.service-card{width:238px;flex-basis:238px;height:104px}.tips-grid{grid-template-columns:1fr}.tip-card:nth-child(even){padding-left:0;border-left:0}.tip-card:nth-child(even):hover{padding-left:9px}.tips-section{margin-top:64px}.section-top{align-items:flex-end;gap:15px}.view-all{white-space:nowrap}}@media(prefers-reduced-motion:reduce){.lane-track{animation:none}.conveyor{overflow-x:auto}.lane{overflow:visible}}
</style>
