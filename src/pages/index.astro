---
// @ts-ignore
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const allExitPosts = await getCollection('blog');
const allPrivacyPosts = await getCollection('privacy');
const exitPosts = allExitPosts.slice(0, 20);
const privacyPosts = allPrivacyPosts.slice(0, 10);
const rowOne = exitPosts.filter((_: any, i: number) => i % 2 === 0);
const rowTwo = exitPosts.filter((_: any, i: number) => i % 2 !== 0);
const domainMap = JSON.stringify(allExitPosts.map((post: any) => ({domain: post.data.domain.toLowerCase(), slug: post.slug})));
const privacySearchData = JSON.stringify(allPrivacyPosts.map((post: any) => ({title: post.data.title.toLowerCase(), slug: post.slug})));
---
<Layout title="Exitz">
<section class="hero"><div class="hero-inner"><p class="eyebrow">ACCOUNT EXIT GUIDE</p><h1>떠나는 것도,<br /><em>깔끔하게.</em></h1><p class="intro">서비스 이름이나 도메인을 검색하면<br />회원 탈퇴 방법을 바로 찾아드려요.</p><form id="search-form" class="search-box"><span class="search-icon" aria-hidden="true">⌕</span><input id="search-input" type="text" placeholder="" required autocomplete="off" aria-label="서비스 검색" /><button type="submit">찾기</button></form><p id="error-message" class="error" hidden>해당 서비스를 아직 찾지 못했어요.</p></div></section>
<section class="content"><div class="section-head"><div><p class="eyebrow">EXPLORE</p><h2>필요한 정보를 골라보세요.</h2></div></div>
<section class="guide-section"><div class="section-label"><span class="label-number">01</span><div><h3>계정 탈퇴 가이드</h3><p>서비스별 탈퇴 방법을 한눈에</p></div><a class="view-all" href="/guides">전체보기 ↗</a></div>
<div class="carousel-window" aria-label="계정 탈퇴 가이드 목록"><div class="guide-row row-one">{[...rowOne,...rowOne].map((post:any)=><a href={`/x/${post.slug}`} class="guide-card">{post.data.logo ? <img class="service-logo" src={post.data.logo} alt={`${post.data.serviceName} 로고`} loading="lazy" /> : <span class="logo-fallback">{post.data.serviceName?.charAt(0)}</span>}<div class="card-copy"><h4>{post.data.title}</h4><span class="domain">{post.data.domain}</span></div><span class="card-arrow">↗</span></a>)}</div><div class="guide-row row-two">{[...rowTwo,...rowTwo].map((post:any)=><a href={`/x/${post.slug}`} class="guide-card">{post.data.logo ? <img class="service-logo" src={post.data.logo} alt={`${post.data.serviceName} 로고`} loading="lazy" /> : <span class="logo-fallback">{post.data.serviceName?.charAt(0)}</span>}<div class="card-copy"><h4>{post.data.title}</h4><span class="domain">{post.data.domain}</span></div><span class="card-arrow">↗</span></a>)}</div></div></section>
<section class="guide-section tips-section"><div class="section-label"><span class="label-number">02</span><div><h3>개인정보 도움말</h3><p>탈퇴 전에 알아두면 좋은 내용</p></div><a class="view-all" href="/tips">전체보기 ↗</a></div><div class="tips-list">{privacyPosts.map((post:any)=><a href={`/h/${post.slug}`} class="tip-card"><div><h4>{post.data.title}</h4><p>{post.data.description}</p></div><span class="card-arrow">↗</span></a>)}</div></section></section>
</Layout>
<script is:inline define:vars={{domainMapJson:domainMap,privacySearchJson:privacySearchData}}>
const domainData=JSON.parse(domainMapJson);const privacyData=JSON.parse(privacySearchJson);const form=document.getElementById('search-form');const input=document.getElementById('search-input');const errorMsg=document.getElementById('error-message');form?.addEventListener('submit',(e)=>{e.preventDefault();errorMsg.hidden=true;const query=input.value.trim().toLowerCase();const domain=query.replace(/^https?:\/\//,'').replace(/^www\./,'').split('/')[0];const exit=domainData.find((x)=>x.domain===domain);if(exit){location.href=`/x/${exit.slug}`;return}const help=privacyData.find((x)=>x.title.includes(query));if(help){location.href=`/h/${help.slug}`;return}errorMsg.hidden=false});
const placeholderTexts=['facebook.com','instagram.com','twitter.com','youtube.com'];let currentIndex=0;function typePlaceholder(){const text=placeholderTexts[currentIndex];let charIndex=0;input.placeholder='';const typingInterval=setInterval(()=>{if(charIndex<text.length){input.placeholder+=text.charAt(charIndex);charIndex++}else{clearInterval(typingInterval);setTimeout(erasePlaceholder,1500)}},100)}function erasePlaceholder(){const erasingInterval=setInterval(()=>{if(input.placeholder.length>0)input.placeholder=input.placeholder.slice(0,-1);else{clearInterval(erasingInterval);currentIndex=(currentIndex+1)%placeholderTexts.length;typePlaceholder()}},30)}typePlaceholder();
</script>
<style>
.hero{border-bottom:1px solid var(--line);background:radial-gradient(circle at 50% 15%,#fff 0,transparent 45%);padding:92px 20px 84px}.hero-inner{width:min(720px,100%);margin:auto;text-align:center}.eyebrow{font-size:.7rem;font-weight:700;letter-spacing:.14em;color:var(--muted);margin-bottom:16px}.hero h1{font-size:clamp(3rem,8vw,5.8rem);line-height:.98;letter-spacing:-.075em;font-weight:700}.hero h1 em{font-style:normal;color:#77746d}.intro{font-size:1rem;color:var(--muted);margin:26px 0 34px}.search-box{height:64px;display:flex;align-items:center;background:var(--surface);border:1px solid #d9d7d0;border-radius:16px;padding:7px 7px 7px 20px;box-shadow:0 12px 36px rgba(23,23,23,.07);text-align:left;transition:.2s}.search-box:focus-within{border-color:#99958c;box-shadow:0 14px 42px rgba(23,23,23,.11)}.search-icon{font-size:1.6rem;color:var(--muted);line-height:1;margin-right:10px}.search-box input{min-width:0;flex:1;border:0;outline:0;background:transparent;font-size:1rem;color:var(--ink)}.search-box input::placeholder{color:#aaa}.search-box button{border:0;background:var(--ink);color:#fff;height:50px;padding:0 23px;border-radius:11px;font-weight:600;cursor:pointer}.search-box button:hover{background:#333}.error{margin-top:12px;color:var(--danger);font-size:.86rem}.content{width:min(1080px,calc(100% - 40px));margin:0 auto;padding:72px 0}.section-head{margin-bottom:38px}.section-head .eyebrow{margin-bottom:5px}.section-head h2{font-size:1.7rem;letter-spacing:-.045em}.guide-section{margin-bottom:76px}.section-label{display:flex;gap:15px;align-items:flex-start;padding-bottom:18px;border-bottom:1px solid var(--line);margin-bottom:18px}.label-number{font-size:.7rem;color:var(--muted);padding-top:4px}.section-label h3{font-size:1.1rem;letter-spacing:-.025em}.section-label p{font-size:.78rem;color:var(--muted);margin-top:2px}.view-all{margin-left:auto;font-size:.75rem;color:var(--muted);text-decoration:none;white-space:nowrap;padding-top:2px}.view-all:hover{color:var(--ink)}.carousel-window{position:relative;overflow:hidden;margin:0 -20px;padding:4px 20px 8px}.carousel-window:before,.carousel-window:after{content:"";position:absolute;z-index:3;top:0;bottom:0;width:85px;pointer-events:none}.carousel-window:before{left:0;background:linear-gradient(90deg,var(--canvas),transparent)}.carousel-window:after{right:0;background:linear-gradient(270deg,var(--canvas),transparent)}.guide-row{display:flex;width:max-content;gap:14px;margin-bottom:14px;will-change:transform}.guide-row:last-child{margin-bottom:0}.row-one{animation:conveyor-forward 38s linear infinite}.row-two{animation:conveyor-backward 42s linear infinite}.carousel-window:hover .guide-row{animation-play-state:paused}.guide-card{position:relative;display:flex;align-items:center;gap:15px;width:300px;height:116px;flex:0 0 300px;padding:18px 40px 18px 18px;text-decoration:none;background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:0 5px 18px rgba(23,23,23,.035);transition:transform .2s,border-color .2s,box-shadow .2s}.guide-card:hover{transform:translateY(-3px);border-color:#bdb9b0;box-shadow:0 10px 28px rgba(23,23,23,.08)}.service-logo,.logo-fallback{width:52px;height:52px;flex:0 0 52px;object-fit:contain;border-radius:14px;background:#fff;border:1px solid var(--line);padding:8px}.logo-fallback{display:grid;place-items:center;background:var(--soft);padding:0;font-weight:700;font-size:1.1rem}.card-copy{min-width:0}.guide-card h4{font-size:.95rem;font-weight:600;letter-spacing:-.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.domain{display:inline-block;margin-top:5px;color:var(--muted);font-size:.72rem}.card-arrow{position:absolute;right:17px;top:17px;color:#aaa;font-size:1rem;transition:.2s}.guide-card:hover .card-arrow,.tip-card:hover .card-arrow{right:13px;color:var(--ink)}@keyframes conveyor-forward{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 7px))}}@keyframes conveyor-backward{from{transform:translateX(calc(-50% - 7px))}to{transform:translateX(0)}}.tips-section{margin-bottom:0}.tips-list{display:grid;grid-template-columns:1fr 1fr;gap:14px}.tip-card{position:relative;display:block;text-decoration:none;border:1px solid var(--line);border-radius:14px;padding:20px 38px 20px 20px;background:var(--surface);transition:.2s}.tip-card:hover{border-color:#bbb7ae;transform:translateY(-2px)}.tip-card p{font-size:.8rem;color:var(--muted);margin-top:5px;line-height:1.5}.tip-card .card-arrow{top:20px;right:16px}.tip-card:hover .card-arrow{right:12px}@media(max-width:600px){.hero{padding:68px 14px 60px}.hero h1{font-size:3.5rem}.content{width:min(100% - 28px,1080px);padding:52px 0}.carousel-window{margin:0 -14px;padding:4px 14px 8px}.guide-card{width:260px;flex-basis:260px;height:110px}.section-label{gap:11px}.view-all{font-size:.7rem}.tips-list{grid-template-columns:1fr}.search-box{height:58px}.search-box button{height:44px;padding:0 18px}.guide-section{margin-bottom:58px}}@media(prefers-reduced-motion:reduce){.guide-row{animation:none}.carousel-window{overflow-x:auto}.carousel-window:before,.carousel-window:after{display:none}}
</style>
