---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
const posts: CollectionEntry<"help">[] = await getCollection("help");
---

<Layout title="개인정보 도움말">
    <section class="listing">
        <div class="heading">
            <p class="eyebrow">ALL PRIVACY TIPS</p>
            <h1>개인정보 도움말</h1>
            <p>알아두면 좋은 개인정보 정보들을 모았습니다.</p>
        </div>
        <div class="grid">
            {
                posts.map((post) => (
                    <a class="tip-card" href={`/help/${post.slug}`}>
                        <div class="tip-content">
                            <h2>{post.data.title}</h2>
                            <p>{post.data.description}</p>
                        </div>
                        <span class="card-arrow" aria-hidden="true">↗</span>
                    </a>
                ))
            }
        </div>
    </section>
</Layout>

<style>
    .listing {
        width: min(1080px, calc(100% - 40px));
        margin: auto;
        padding: 80px 0;
    }
    .heading {
        margin-bottom: 42px;
    }
    .eyebrow {
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        color: var(--muted);
        font-weight: 700;
        margin-bottom: 8px;
    }
    .heading h1 {
        font-size: clamp(2.4rem, 6vw, 4rem);
        letter-spacing: -0.06em;
        margin: 8px 0;
        font-weight: 700;
        color: var(--ink);
    }
    .heading p:last-child {
        color: var(--muted);
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }
    .tip-card {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        text-decoration: none;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 22px 46px 22px 22px;
        background: var(--surface, #fff);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .tip-card:hover {
        border-color: #c2bebd;
        transform: translateY(-3px);
        box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.07);
    }
    .tip-content {
        min-width: 0;
    }
    .tip-card h2 {
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    .tip-card p {
        font-size: 0.85rem;
        color: var(--muted);
        margin-top: 6px;
        line-height: 1.52;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .card-arrow {
        position: absolute;
        right: 20px;
        top: 24px;
        color: #b0adad;
        font-size: 1.15rem;
        transition: transform 0.25s ease, color 0.25s ease;
    }
    .tip-card:hover .card-arrow {
        color: var(--ink);
        transform: translate(3px, -3px);
    }
    @media (max-width: 768px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }
    @media (max-width: 600px) {
        .listing {
            width: calc(100% - 28px);
            padding: 60px 0;
        }
    }
</style>