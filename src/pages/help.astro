---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getViewCounts } from "../lib/views";
import { SORT_LABELS, SORT_OPTIONS, normalizeSort, sortPosts } from "../lib/sort";

const INITIAL_LIMIT = 8;
const sort = normalizeSort(Astro.url.searchParams.get("sort"));

const allPosts: CollectionEntry<"help">[] = await getCollection("help");
const slugs = allPosts.map((post) => post.slug);
const viewMap = await getViewCounts(
    Astro.locals.runtime.env,
    "help",
    slugs,
);
const sortedPosts = sortPosts(allPosts, viewMap, sort);

const initialPosts = sortedPosts.slice(0, INITIAL_LIMIT);
const initialHasMore = sortedPosts.length > INITIAL_LIMIT;
const currentUrl = Astro.url.toString();
---

<Layout
    title="개인정보 도움말"
    description="알아두면 좋은 개인정보 정보들을 모았습니다."
    url={currentUrl}
>
    <section class="listing">
        <div class="heading">
            <p class="eyebrow">ALL PRIVACY TIPS</p>
            <h1>개인정보 도움말</h1>
            <p>알아두면 좋은 개인정보 정보들을 모았습니다.</p>
        </div>

        <div class="sort-bar" role="tablist" aria-label="정렬 방식">
            {
                SORT_OPTIONS.map((opt) => (
                    <a
                        href={`/help?sort=${opt}`}
                        class={`sort-btn ${sort === opt ? "is-active" : ""}`}
                        role="tab"
                        aria-selected={sort === opt ? "true" : "false"}
                    >
                        {SORT_LABELS[opt]}
                    </a>
                ))
            }
        </div>

        <div class="grid" id="help-grid">
            {
                initialPosts.map((post) => (
                    <a class="tip-card" href={`/help/${post.slug}`}>
                        <div class="tip-content">
                            <h2>{post.data.title}</h2>
                            <p>{post.data.description}</p>
                            <span class="view-badge">
                                <span aria-hidden="true">👁</span>
                                {(viewMap[post.slug] || 0).toLocaleString("ko-KR")}
                            </span>
                        </div>
                        <span class="card-arrow" aria-hidden="true">
                            ↗
                        </span>
                    </a>
                ))
            }
        </div>

        <div
            id="sentinel"
            class="sentinel"
            data-has-more={initialHasMore ? "true" : "false"}
        >
            <div class="spinner" id="spinner"></div>
        </div>
    </section>
</Layout>

<script is:inline define:vars={{ currentSort: sort }}>
    let page = 1;
    const limit = 8;
    let isLoading = false;
    const sort = currentSort;

    const grid = document.getElementById("help-grid");
    const sentinel = document.getElementById("sentinel");
    const spinner = document.getElementById("spinner");

    if (sentinel.dataset.hasMore === "false") {
        spinner.style.display = "none";
    }

    function escapeHtml(str) {
        if (!str) return "";
        return String(str)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    function createCardHTML(post) {
        const views = typeof post.views === "number" ? post.views : 0;
        return `
      <a class="tip-card" href="/help/${post.slug}">
        <div class="tip-content">
          <h2>${escapeHtml(post.title)}</h2>
          <p>${escapeHtml(post.description)}</p>
          <span class="view-badge"><span aria-hidden="true">👁</span>${views.toLocaleString("ko-KR")}</span>
        </div>
        <span class="card-arrow" aria-hidden="true">↗</span>
      </a>
    `;
    }

    async function loadMore() {
        if (isLoading || sentinel.dataset.hasMore === "false") return;
        isLoading = true;
        page += 1;

        try {
            const res = await fetch(
                `/api/posts?type=help&page=${page}&limit=${limit}&sort=${sort}`,
            );
            const data = await res.json();

            if (data.items && data.items.length > 0) {
                const html = data.items.map(createCardHTML).join("");
                grid.insertAdjacentHTML("beforeend", html);
            }

            if (!data.hasMore) {
                sentinel.dataset.hasMore = "false";
                spinner.style.display = "none";
                observer.disconnect();
            }
        } catch (e) {
            console.error(e);
        } finally {
            isLoading = false;
        }
    }

    const observer = new IntersectionObserver(
        (entries) => {
            if (entries[0].isIntersecting) {
                loadMore();
            }
        },
        { rootMargin: "200px" },
    );

    if (sentinel && sentinel.dataset.hasMore === "true") {
        observer.observe(sentinel);
    }
</script>

<style>
    .listing {
        width: min(1080px, calc(100% - 40px));
        margin: auto;
        padding: 80px 0;
    }
    .heading {
        margin-bottom: 42px;
    }
    .eyebrow {
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        color: var(--muted);
        font-weight: 700;
        margin-bottom: 8px;
    }
    .heading h1 {
        font-size: clamp(2.4rem, 6vw, 4rem);
        letter-spacing: -0.06em;
        margin: 8px 0;
        font-weight: 700;
        color: var(--ink);
    }
    .heading p:last-child {
        color: var(--muted);
    }
    .sort-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 24px;
    }
    .sort-btn {
        display: inline-flex;
        align-items: center;
        padding: 9px 16px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--surface, #fff);
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .sort-btn:hover {
        color: var(--ink);
        border-color: #c2bebd;
    }
    .sort-btn.is-active {
        background: var(--ink);
        border-color: var(--ink);
        color: #fff;
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }
    :global(.tip-card) {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        text-decoration: none;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 22px 46px 22px 22px;
        background: var(--surface, #fff);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.tip-card:hover) {
        border-color: #c2bebd;
        transform: translateY(-3px);
        box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.07);
    }
    :global(.tip-content) {
        min-width: 0;
    }
    :global(.tip-card h2) {
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    :global(.tip-card p) {
        font-size: 0.85rem;
        color: var(--muted);
        margin-top: 6px;
        line-height: 1.52;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    :global(.view-badge) {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 10px;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--muted);
    }
    :global(.card-arrow) {
        position: absolute;
        right: 20px;
        top: 24px;
        color: #b0adad;
        font-size: 1.15rem;
        transition:
            transform 0.25s ease,
            color 0.25s ease;
    }
    :global(.tip-card:hover .card-arrow) {
        color: var(--ink);
        transform: translate(3px, -3px);
    }
    .sentinel {
        display: flex;
        justify-content: center;
        padding: 40px 0 20px;
        min-height: 50px;
    }
    .spinner {
        width: 28px;
        height: 28px;
        border: 3px solid rgba(0, 0, 0, 0.1);
        border-top-color: var(--ink, #111);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @media (max-width: 768px) {
        .listing {
            width: calc(100% - 32px);
            padding: 40px 0;
        }
        .heading {
            margin-bottom: 28px;
        }
        .grid {
            grid-template-columns: 1fr;
        }
        .sort-bar {
            margin-bottom: 18px;
        }
        .sort-btn {
            padding: 8px 14px;
            font-size: 0.8rem;
        }
    }
</style>