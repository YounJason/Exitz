---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const posts = await getCollection('blog');
---
<Layout title="계정 탈퇴 가이드"><section class="listing"><div class="heading"><p class="eyebrow">ALL EXIT GUIDES</p><h1>계정 탈퇴 가이드</h1><p>서비스별 탈퇴 방법을 한곳에서 찾아보세요.</p></div><div class="grid">{posts.map((post) => <a class="card" href={`/x/${post.slug}`}>{post.data.logo && <img src={post.data.logo} alt="" /> }<div><h2>{post.data.title}</h2><span>{post.data.domain}</span></div><b>↗</b></a>)}</div></section></Layout>
<style>.listing{width:min(1080px,calc(100% - 40px));margin:auto;padding:80px 0}.heading{margin-bottom:42px}.eyebrow{font-size:.7rem;letter-spacing:.14em;color:var(--muted);font-weight:700}.heading h1{font-size:clamp(2.4rem,6vw,4rem);letter-spacing:-.06em;margin:8px 0}.heading p:last-child{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card{position:relative;display:flex;align-items:center;gap:14px;min-height:108px;padding:20px;border:1px solid var(--line);border-radius:16px;background:var(--surface);text-decoration:none;transition:.2s}.card:hover{transform:translateY(-3px);border-color:#bbb7ae}.card img{width:46px;height:46px;object-fit:contain;padding:8px;border:1px solid var(--line);border-radius:12px}.card h2{font-size:1rem}.card span{font-size:.75rem;color:var(--muted)}.card b{position:absolute;right:16px;top:15px;color:#aaa}@media(max-width:760px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:500px){.listing{width:calc(100% - 28px);padding:60px 0}.grid{grid-template-columns:1fr}}</style>
