---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const exitPosts = await getCollection("exit");
  return exitPosts.map((post: CollectionEntry<"exit">) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"exit"> };
const { Content } = await post.render();
---

<Layout title={post.data.title}>
  <div class="container article-container">
    <nav class="breadcrumb">
      <a href="/">Exitz</a> &gt; <a href="/exit">계정 탈퇴 가이드</a>
    </nav>

    <article class="article-content">
      <div class="article-header">
        {post.data.logo && (
          <img class="service-logo" src={post.data.logo} alt="" />
        )}
        <div>
          <h1>{post.data.title}</h1>
          <div class="article-meta">
            {post.data.description && <p class="description">{post.data.description}</p>}
            <span>최근 업데이트: {post.data.pubDate.toISOString().slice(0, 10)}</span>
          </div>
        </div>
      </div>

      <hr class="divider" />

      <div class="markdown-body">
        <Content />
      </div>
    </article>
  </div>
</Layout>

<style>
  .article-container {
    width: min(720px, calc(100% - 40px));
    margin: 0 auto;
    padding-top: 48px;
    padding-bottom: 80px;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 24px;
    font-weight: 500;
  }
  .breadcrumb a {
    color: var(--ink);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .article-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }
  .service-logo {
    width: 58px;
    height: 58px;
    object-fit: contain;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--line);
    padding: 8px;
  }
  .description {
    font-size: 1.05rem;
    color: var(--muted);
    margin-bottom: 8px;
    line-height: 1.5;
  }
  .article-content h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.2;
    color: var(--ink);
  }
  .article-meta {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 6px;
  }
  .divider {
    border: none;
    border-top: 1px solid var(--line);
    margin: 32px 0;
  }
  .markdown-body :global(h2) {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 40px;
    margin-bottom: 16px;
    color: var(--ink);
  }
  .markdown-body :global(p) {
    margin-bottom: 20px;
    color: var(--ink);
    line-height: 1.7;
    font-size: 1rem;
  }
  @media (max-width: 600px) {
    .article-container {
      width: calc(100% - 28px);
      padding-top: 36px;
      padding-bottom: 60px;
    }
    .article-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>