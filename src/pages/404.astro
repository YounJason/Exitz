---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const INITIAL_LIMIT = 8;
const allPosts: CollectionEntry<"help">[] = await getCollection("help");
const initialPosts = allPosts.slice(0, INITIAL_LIMIT);
const initialHasMore = allPosts.length > INITIAL_LIMIT;
---

<Layout title="404 - 페이지를 찾을 수 없습니다.">
    <section class="listing">
        <div class="heading">
            <p class="eyebrow">404</p>
            <h1>페이지를 찾을 수 없습니다.</h1>
            <button onclick="window.location.href='/'">
                <div class="tip-content">
                    <h2>홈으로 돌아가기 ↗</h2>
                </div>
                <span class="card-arrow" aria-hidden="true"></span>
            </button>
        </div>
    </section>
</Layout>

<style>
    .listing {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        padding: 2rem;
    }

    .heading {
        text-align: center;
        max-width: 600px;
    }

    .eyebrow {
        font-size: 3rem;
        font-weight: 700;
        margin: 0;
        color: var(--accent);
        line-height: 1;
    }

    h1 {
        font-size: 2.5rem;
        margin: 1rem 0;
        color: var(--text);
        font-weight: 700;
    }

    p {
        font-size: 1.1rem;
        color: var(--text-secondary, #666);
        margin: 1rem 0 0 0;
        line-height: 1.6;
    }

    button {
        border: 0;
        background: var(--ink);
        color: #fff;
        height: 50px;
        padding: 0 23px;
        border-radius: 11px;
        font-weight: 600;
        cursor: pointer;
    }

    button:hover {
        background: #333;
    }

    @media (max-width: 640px) {
        .eyebrow {
            font-size: 2rem;
        }

        h1 {
            font-size: 1.5rem;
        }

        p {
            font-size: 1rem;
        }

        .listing {
            min-height: 50vh;
            padding: 1.5rem;
        }
    }
</style>
