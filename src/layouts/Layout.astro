---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Exitz</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- 상단 헤더 -->
    <header class="header">
      <div class="header-container">
        <a href="/" class="logo">
          <svg width="36" height="36" viewBox="0 0 24 24"><defs><filter id="a" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy=".8" stdDeviation=".6" flood-color="#000" flood-opacity=".3"/></filter></defs><rect width="24" height="24" rx="4" fill="#1a73e8"/><path d="M9 19H7a1.5 1.5 0 0 1-1.5-1.5v-11A1.5 1.5 0 0 1 7 5h2m6 10 3.5-3.5L15 8m3.5 3.5H10" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" filter="url(#a)"/></svg>
          <span class="logo-text">Exitz</span>
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- 하단 푸터 -->
    <footer class="footer">
      <div class="container">
        <p>© 2026 Exitz. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --google-blue: #1a73e8;
    --google-blue-hover: #1557b0;
    --text-primary: #202124;
    --text-secondary: #5f6368;
    --bg-light: #f8f9fa;
    --border-color: #dadce0;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Noto Sans KR', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--text-primary);
    background-color: #fff;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
  }

  .header {
    border-bottom: 1px solid var(--border-color);
    padding: 12px 24px;
    background: #fff;
  }

  .header-container {
    max-width: 1024px;
    margin: 0 auto;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text-primary);
  }

  .logo-text {
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.5px;
    color: var(--google-blue);
  }

  .footer {
    border-top: 1px solid var(--border-color);
    background-color: var(--bg-light);
    padding: 24px;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-top: 60px;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
  }
</style>