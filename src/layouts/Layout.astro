---
interface Props {
  title: string;
  indexTitle?: boolean;
  description?: string;
  image?: string;
  url?: string;
  type?: string;
}

const {
  title,
  indexTitle = false,
  description,
  image,
  url,
  type,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : "https://exitz.me";
const pageTitle = indexTitle ? title : `${title} · Exitz`;
const metaDescription = description ?? "떠나는 것도, 깔끔하게. Exitz.";
const metaType = type ?? "website";
const canonicalUrl = url ?? siteUrl;
const defaultImage = "/logo2.png";
const targetImage = image ?? defaultImage;
const metaImage = targetImage.startsWith("http")
  ? targetImage
  : new URL(targetImage, siteUrl).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f7f5" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:site_name" content="Exitz" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={metaType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={metaImage} />
    <meta name="twitter:image" content={metaImage} />
    <meta
      name="twitter:card"
      content={metaImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="shortcut icon" href="/icon.svg" />
    <title>{indexTitle ? title : `${title} · Exitz`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3817407804978670"
      crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="Exitz 홈">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="5 5 54 54"
            width="28"
            height="28"
            fill="none"
            ><path
              d="M18 52V14a2 2 0 0 1 2-2h24a2 2 0 0 1 2 2"
              stroke="#191f28"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"></path><path
              d="M12 52h40"
              stroke="#191f28"
              stroke-width="4"
              stroke-linecap="round"></path><path
              d="M28 32h20m-6-7 7 7-7 7"
              stroke="#191f28"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          <span>Exitz</span>
        </a>
        <nav aria-label="메뉴">
          <a href="/exit">탈퇴 가이드</a>
          <a href="/help">개인정보 도움말</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>© 2026 Exitz</span><span>Exitz</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #171717;
    --muted: #77746d;
    --line: #e5e3dc;
    --surface: #fff;
    --canvas: #f7f7f5;
    --soft: #eceae4;
    --danger: #c94335;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    font-family: "DM Sans", "Noto Sans KR", sans-serif;
    color: var(--ink);
    background: var(--canvas);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }
  main {
    flex: 1;
  }
  a {
    color: inherit;
  }
  button,
  input {
    font: inherit;
  }
  .site-header {
    background: rgba(247, 247, 245, 0.88);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(14px);
  }
  .header-inner,
  .footer-inner {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
  }
  .header-inner {
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.03em;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  nav a:hover {
    color: var(--ink);
  }
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 72px;
  }
  .footer-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.8rem;
  }
  @media (max-width: 600px) {
    .header-inner,
    .footer-inner {
      width: min(100% - 28px, 1080px);
    }
    .header-inner {
      height: 60px;
    }
    nav {
      gap: 12px;
    }
    nav a {
      font-size: 0.84rem;
    }
    .footer-inner {
      gap: 8px;
      align-items: flex-start;
      justify-content: center;
      flex-direction: column;
    }
  }
</style>
