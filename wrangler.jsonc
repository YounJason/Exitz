{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exitz",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/_server-islands/*",
      "/_image",
      "/api/*",
      "/exit",
      "/help"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "VIEWS",
      "id": "683a691d05884a419f29a3bfa8c2f9da"
    }
  ],
  "observability": {
    "enabled": true
  }
}