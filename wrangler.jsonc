{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exitz",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}